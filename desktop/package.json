{
  "name": "ressectionlab-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Local research workspace for patient-specific route inspection",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "package:mac": "node electron/package-macos.cjs",
    "test": "pnpm test:main && pnpm test:renderer && pnpm test:viewer",
    "test:main": "node --test electron/*.test.cjs",
    "test:viewer": "node --experimental-strip-types --test src/viewer/*.test.mjs",
    "test:renderer": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "type": "module"
}
