<?xml version='1.0' encoding='utf-8'?>
<febio_spec version="4.0">
  <!--Analytical software fixture only; nodal averages are NOT patient tent kernels; SI units-->
  <Module type="solid" />
  <Control>
    <analysis>STATIC</analysis>
    <time_steps>4</time_steps>
    <step_size>0.25</step_size>
    <plot_level>PLOT_NEVER</plot_level>
    <output_level>OUTPUT_MAJOR_ITRS</output_level>
    <output_stride>1</output_stride>
    <time_stepper type="default">
      <max_retries>0</max_retries>
      <dtmin>0.25</dtmin>
      <dtmax>0.25</dtmax>
    </time_stepper>
    <solver type="solid">
      <symmetric_stiffness>1</symmetric_stiffness>
      <max_refs>20</max_refs>
      <dtol>1e-10</dtol>
      <etol>1e-10</etol>
      <rtol>1e-10</rtol>
      <min_residual>1e-20</min_residual>
      <qn_method type="BFGS" />
      <linear_solver type="skyline" />
    </solver>
  </Control>
  <Material>
    <material id="1" name="numerical_ogden" type="Ogden">
      <c1>2000.0</c1>
      <m1>2</m1>
      <c2>0</c2>
      <m2>2</m2>
      <c3>0</c3>
      <m3>2</m3>
      <c4>0</c4>
      <m4>2</m4>
      <c5>0</c5>
      <m5>2</m5>
      <c6>0</c6>
      <m6>2</m6>
      <k>9666.6666666666661</k>
      <pressure_model>1</pressure_model>
    </material>
  </Material>
  <Mesh>
    <Nodes name="fixture_nodes">
      <node id="1">0,0,0</node>
      <node id="2">0.01,0,0</node>
      <node id="3">0.01,0.01,0</node>
      <node id="4">0,0.01,0</node>
      <node id="5">0,0,0.01</node>
      <node id="6">0.01,0,0.01</node>
      <node id="7">0.01,0.01,0.01</node>
      <node id="8">0,0.01,0.01</node>
      <node id="9">0.0050000000000000001,0,0</node>
      <node id="10">0.01,0.0050000000000000001,0</node>
      <node id="11">0.0050000000000000001,0.0050000000000000001,0</node>
      <node id="12">0.0050000000000000001,0.0050000000000000001,0.0050000000000000001</node>
      <node id="13">0.01,0.0050000000000000001,0.0050000000000000001</node>
      <node id="14">0.01,0.01,0.0050000000000000001</node>
      <node id="15">0.0050000000000000001,0.01,0</node>
      <node id="16">0,0.0050000000000000001,0</node>
      <node id="17">0.0050000000000000001,0.01,0.0050000000000000001</node>
      <node id="18">0,0.01,0.0050000000000000001</node>
      <node id="19">0,0.0050000000000000001,0.0050000000000000001</node>
      <node id="20">0.0050000000000000001,0.01,0.01</node>
      <node id="21">0,0.0050000000000000001,0.01</node>
      <node id="22">0,0,0.0050000000000000001</node>
      <node id="23">0.0050000000000000001,0.0050000000000000001,0.01</node>
      <node id="24">0.0050000000000000001,0,0.01</node>
      <node id="25">0.0050000000000000001,0,0.0050000000000000001</node>
      <node id="26">0.01,0.0050000000000000001,0.01</node>
      <node id="27">0.01,0,0.0050000000000000001</node>
    </Nodes>
    <Elements type="tet10" name="fixture">
      <elem id="1">1,2,3,7,9,10,11,12,13,14</elem>
      <elem id="2">1,3,4,7,11,15,16,12,14,17</elem>
      <elem id="3">1,4,8,7,16,18,19,12,17,20</elem>
      <elem id="4">1,8,5,7,19,21,22,12,20,23</elem>
      <elem id="5">1,5,6,7,22,24,25,12,23,26</elem>
      <elem id="6">1,6,2,7,25,27,9,12,26,13</elem>
    </Elements>
  </Mesh>
  <MeshDomains>
    <SolidDomain name="fixture" mat="numerical_ogden" elem_type="TET10G8" type="elastic-solid" />
  </MeshDomains>
  <Boundary>
    <bc type="linear constraint">
      <node>1</node>
      <dof>x</dof>
      <offset lc="1">0.00059999999999999995</offset>
      <child_dof>
        <node>12</node>
        <dof>x</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>1</node>
      <dof>y</dof>
      <offset lc="1">-0.00040000000000000002</offset>
      <child_dof>
        <node>12</node>
        <dof>y</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>1</node>
      <dof>z</dof>
      <offset lc="1">0.00020000000000000001</offset>
      <child_dof>
        <node>12</node>
        <dof>z</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>2</node>
      <dof>x</dof>
      <offset lc="1">0.00059999999999999995</offset>
      <child_dof>
        <node>12</node>
        <dof>x</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>2</node>
      <dof>y</dof>
      <offset lc="1">-0.00040000000000000002</offset>
      <child_dof>
        <node>12</node>
        <dof>y</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>2</node>
      <dof>z</dof>
      <offset lc="1">0.00020000000000000001</offset>
      <child_dof>
        <node>12</node>
        <dof>z</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>4</node>
      <dof>x</dof>
      <offset lc="1">0.00059999999999999995</offset>
      <child_dof>
        <node>12</node>
        <dof>x</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>4</node>
      <dof>y</dof>
      <offset lc="1">-0.00040000000000000002</offset>
      <child_dof>
        <node>12</node>
        <dof>y</dof>
        <value>-1</value>
      </child_dof>
    </bc>
    <bc type="linear constraint">
      <node>4</node>
      <dof>z</dof>
      <offset lc="1">0.00020000000000000001</offset>
      <child_dof>
        <node>12</node>
        <dof>z</dof>
        <value>-1</value>
      </child_dof>
    </bc>
  </Boundary>
  <LoadData>
    <load_controller id="1" type="loadcurve">
      <interpolate>LINEAR</interpolate>
      <points>
        <pt>0,0</pt>
        <pt>1,1</pt>
      </points>
    </load_controller>
  </LoadData>
  <Output>
    <logfile file="mpc_translation.log">
      <node_data data="x;y;z;ux;uy;uz;Rx;Ry;Rz" name="mechanics_nodes_si" file="mpc_translation.nodes.log" delim="," />
      <element_data data="sx;sy;sz;sxy;syz;sxz;J;sed" name="mechanics_elements_si" file="mpc_translation.elements.log" delim="," />
    </logfile>
  </Output>
</febio_spec>
