+@pytest.mark.parametrize('change',['missing','extra','prep','output','native_hash','sidecar_hash','ledger','wrong_ordinal'])
+def test_ordinal9_marker_and_numeric_tamper_refuse(change):
+    side,envelope,native,kwargs=ordinal9_extension_fixture()
+    marker=side['charged_previous']['v2_surcharge_applied']
+    if change=='missing':del side['charged_previous']['v2_surcharge_applied']
