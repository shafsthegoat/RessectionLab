+def _target_ray_group_order(cells, groups, eligible, nominal_cells, limit):
+    """Pure public-evidence order; group aliases do not receive extra turns.
+
+    Each group is a declared source-column/tool pair. Its retained first-failure
+    cells are unioned across public-goal endpoints, including coincident family
+    aliases. One pass nominates at most one not-yet-selected cell per group;
+    shared cells are skipped without spending another global cell slot. This is
+    candidate coverage, never proof that all corridor blockers are discovered,
+    feasible to remove, or removable at useful total cost.
+    """
+    cells, eligible, nominal_cells = set(cells), set(eligible), set(nominal_cells)
+    if not eligible <= cells or not nominal_cells <= cells or type(limit) is not int or limit < 1:
+        raise ValueError("Explicit bounded public blocker sets required")
+    merged = {}
+    for key, blockers in groups:
+        blockers = set(blockers)
+        if not blockers <= cells:
+            raise ValueError("Target-ray group contains undeclared evidence")
+        merged.setdefault(tuple(key), set()).update(blockers)
+    order = sorted(eligible & nominal_cells); used = set(order)
+    pending = {key: sorted(blockers & eligible) for key, blockers in merged.items()}
+    while True:
+        added = False
+        for key in sorted(pending):
+            remaining = pending[key]
+            while remaining and remaining[0] in used:
+                remaining.pop(0)
+            if remaining:
+                cell = remaining.pop(0); order.append(cell); used.add(cell); added = True
+        if not added:
+            break
+    order.extend(sorted(eligible-used)); used.update(eligible)
+    order.extend(sorted(cells-used))
+    selected = set(order[:min(limit, len(eligible))])
+    accounting = [{"column_index": key[0], "tool_order": key[1],
+        "retained_co_blockers": sorted(merged[key]),
+        "aperture_eligible_co_blockers": sorted(merged[key] & eligible),
+        "selected_co_blockers": sorted(merged[key] & selected),
+        "unselected_co_blockers": sorted(merged[key]-selected),
+        "all_retained_co_blockers_selected": merged[key] <= selected}
+        for key in sorted(merged)]
+    return order, accounting
+
+
