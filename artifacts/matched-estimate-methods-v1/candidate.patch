+"""Tiny generated DEVELOPMENT comparison using existing nominal planners.
+
+Planning and evaluation are separate calls. The former cannot receive a private
+reference loader. Frozen IL/RL actors consume only SpatialObservation; HYBRID
+uses the same RL actor solely to order the existing strong search expansions.
+These helpers do not load checkpoints, train, admit patients, or model injury.
+"""
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from dataclasses import asdict, dataclass
+import json
+from pathlib import Path
+import time
+
+import numpy as np
+import torch
+
+from resectionlab.core import array_digest, freeze_json, immutable_array, semantic_digest, thaw_json
+from resectionlab.native_resection import NativeResectionEngine
+from resectionlab.native_spatial_evaluation import evaluate_native_spatial_episode
+from resectionlab.native_spatial_task import NativeSpatialTask
+from resectionlab.observed_search import observed_beam_search
+from resectionlab.planning_budget import PlanningBudget
+from resectionlab.research_estimate_planning import (
+    Abstention, ResearchEstimatePlanningSpec, _estimate_case, _physical_hash,
+    _preflight_nominal_task, research_planning_from_estimates,
+    research_strategy_from_record, research_strategy_to_record,
+)
+from resectionlab.spatial_policy import parameter_hash
+from resectionlab.spatial_policy_diagnostics import NativePreviewProfiler
+
+METHODS = ("SEARCH", "IL", "RL", "HYBRID")
+VERSION = "generated-matched-estimate-methods-v1"
+
+
+@dataclass(frozen=True)
+class MatchedBudget:
+    search_calls: int = 256
+    beam_width: int = 16
+    method_seconds: float = 10.
+    native_previews: int = 2048
+
+    def __post_init__(self):
+        if (any(type(v) is not int or v < 1 for v in
+                (self.search_calls, self.beam_width, self.native_previews))
+                or type(self.method_seconds) not in (int, float)
+                or not np.isfinite(self.method_seconds) or self.method_seconds <= 0):
+            raise ValueError("Explicit positive matched method budgets are required")
+
+
+def _write(path: Path, value) -> None:
+    path.write_text(json.dumps(thaw_json(freeze_json(value)), sort_keys=True, indent=2,
+                               allow_nan=False) + "\n")
+
+
+def _generated_spec(spec):
+    if (type(spec) is not ResearchEstimatePlanningSpec
+            or not spec.declaration.patient_group.startswith("GENERATED:")
+            or spec.horizon != 2 or spec.sources[0].image.shape != (9, 9, 7)
+            or int(spec.support.mask.sum()) != 6 or len(spec.tools) != 2):
+        raise ValueError("Only the declared small generated development comparison is supported")
+    spec.assert_intact()
+
+
+def _rollout_actor(task, policy, details, check):
+    """Unchanged deterministic masked argmax, executed to STOP or horizon."""
+    actions = []
+    while not task.terminated:
+        check()
+        observation = task.observation()
+        observation.assert_intact()
+        details["actor_forward_calls"] += 1
+        with torch.inference_mode():
+            logits, _ = policy(observation)
+        scores = logits.detach().cpu().numpy()
+        legal = observation.action_mask
+        if scores.shape != legal.shape or not np.isfinite(scores[legal]).all():
+            raise ValueError("Actor requires finite scores for each legal action")
+        selected = int(np.argmax(np.where(legal, scores, -np.inf)))
+        action = observation.action_ids[selected]
+        movement = scores[legal & (np.arange(len(scores)) != 0)]
+        details["decisions"].append({"observation_hash": observation.fingerprint,
+            "action_ids": list(observation.action_ids), "selected_action": action,
+            "legal_logits": [float(value) if allowed else None for value, allowed in zip(scores, legal)],
+            "stop_minus_best_movement": float(scores[0] - movement.max()) if len(movement) else None})
+        details["model_transition_calls"] += 1
+        task.advance_planning(action)
+        actions.append(action)
+        check()
+    return tuple(actions)
+
+
+def plan_matched_estimates(spec: ResearchEstimatePlanningSpec, *, il_policy, rl_policy,
+        training_accounting: Mapping, output: Path, budget: MatchedBudget = MatchedBudget()) -> dict:
+    """Durably finish every method slot before permitting separate evaluation.
+
+    Caller-supplied training accounting is retained rather than inferred from a
+    method name. Small unit tests must label scripted policies as scripted.
+    Each online guard includes input reconstruction, decision generation, seal
+    replay, complete strategy export, and durable writing. Independent evaluation
+    happens later. Process-level resource supervision remains the runner's job.
+    """
+    _generated_spec(spec)
+    if type(budget) is not MatchedBudget:
+        raise ValueError("Typed method budget required")
+    policies = {"IL": il_policy, "RL": rl_policy, "HYBRID": rl_policy}
+    if any(not isinstance(p, torch.nn.Module) or p.training for p in policies.values()):
+        raise ValueError("Caller must supply frozen evaluation-mode IL and RL modules")
+    if set(training_accounting) != {"IL", "RL"}:
+        raise ValueError("Preserve explicit IL and RL training accounting")
+    output = Path(output)
+    output.mkdir(parents=True, exist_ok=False)
+    began = time.perf_counter()
+    initial_hashes = {name: parameter_hash(policy) for name, policy in policies.items()}
+    suite = {"version": VERSION, "scope": "generated_development_not_patient_transfer",
+        "input_hash": spec.fingerprint, "budget": asdict(budget),
+        "training_accounting": thaw_json(freeze_json(training_accounting)),
+        "method_order": list(METHODS), "methods": {name: {"status": "not_started", "strategy": None,
+            "outcomes": None} for name in METHODS}, "real_patient_count": 0, "optimizer_updates": 0}
+    # This preflight is common preparation, outside all four online guards.
+    with NativePreviewProfiler(NativeResectionEngine) as profile:
+        initial = _preflight_nominal_task(spec)
+    suite["shared_preparation"] = {"seconds": time.perf_counter() - began,
+        "native_previews": profile.snapshot()}
+    if type(initial) is Abstention:
+        for row in suite["methods"].values():
+            row.update(status="abstained", reason=initial.reason)
+    else:
+        del initial
+        for method in METHODS:
+            row = suite["methods"][method]
+            details = {"model_transition_calls": 0, "actor_forward_calls": 0, "decisions": []}
+            row.update(status="started", details=details)
+            policy = policies.get(method)
+            row["parameter_hash"] = initial_hashes.get(method)
+            guard = PlanningBudget(NativeResectionEngine, max_native_previews=budget.native_previews,
+                                   seconds=budget.method_seconds)
+            active = []
+            try:
+                with guard:
+                    if policy is not None and parameter_hash(policy) != initial_hashes[method]:
+                        raise ValueError("Frozen actor changed before method execution")
+                    def planner(task):
+                        active.append(task)
+                        if method in {"SEARCH", "HYBRID"}:
+                            sequence, costs = observed_beam_search(task,
+                                max_calls=budget.search_calls, beam_width=budget.beam_width,
+                                seconds=budget.method_seconds, policy=policy,
+                                transition_mode="lazy_planning")
+                            details.update(costs)
+                        else:
+                            sequence = _rollout_actor(task, policy, details, guard.check)
+                        guard.check()
+                        return sequence, {name: details[name] for name in
+                                          ("model_transition_calls", "actor_forward_calls")}
+                    configuration = {"method": method, "budget": asdict(budget),
+                        "parameter_hash": initial_hashes.get(method),
+                        "algorithm": "argmax" if method in {"IL", "RL"} else "observed_beam_search",
+                        "guidance": "RL_actor_expansion_order_only" if method == "HYBRID" else None}
+                    sealed = research_planning_from_estimates(spec, method=method,
+                        configuration_hash=semantic_digest(configuration), planner=planner)
+                    if type(sealed) is Abstention:
+                        raise RuntimeError("Inputs changed after common successful preflight")
+                    if policy is not None and parameter_hash(policy) != initial_hashes[method]:
+                        raise ValueError("Frozen actor changed during method execution")
+                    strategy = research_strategy_to_record(sealed, spec)
+                    row.update(strategy=strategy,
+                        seal_and_export_replay_transition_calls=2 * len(sealed.action_ids))
+                    _write(output / (method + "-strategy.json"), strategy)
+                    guard.complete(history_complete=True)
+                row["status"] = "complete"
+            except Exception as error:
+                row.update(status="failed", error=type(error).__name__ + ": " + str(error), strategy=None)
+                if active:
+                    try:
+                        row["partial_nominal_history"] = active[0].metrics()["history"]
+                    except Exception as history_error:
+                        row["partial_history_unavailable"] = type(history_error).__name__
+                if hasattr(error, "accounting"):
+                    row["failure_accounting"] = error.accounting
+            row["online_budget"] = guard.snapshot()
+            _write(output / (method + "-method.json"), row)
+    complete = [row["strategy"]["plan"]["initial_observation_hash"] for row in suite["methods"].values()
+                if row["status"] == "complete"]
+    if len(set(complete)) > 1:
+        raise ValueError("Methods did not receive identical initial permitted observations")
+    suite["seal_hash"] = semantic_digest(suite)
+    _write(output / "planning-suite.json", suite)
+    return thaw_json(freeze_json(suite))
+
+
+def evaluate_matched_estimates(suite: Mapping, spec: ResearchEstimatePlanningSpec,
+        *, load_reference: Callable[[], np.ndarray], output: Path) -> dict:
+    """Score sealed strategies with existing independent native geometry/metrics.
+
+    The evaluator-owned array is a generated target-only counterfactual, not
+    hidden patient anatomy. No actor or search decision is requested here.
+    """
+    started = time.perf_counter()
+    _generated_spec(spec)
+    payload = dict(suite)
+    claimed = payload.pop("seal_hash", None)
+    if (claimed != semantic_digest(payload) or payload.get("version") != VERSION
+            or payload.get("input_hash") != spec.fingerprint
+            or payload.get("method_order") != list(METHODS) or set(payload.get("methods", {})) != set(METHODS)):
+        raise ValueError("Complete fixed method denominator and suite seal required")
+    plans = {}
+    for method in METHODS:
+        row = payload["methods"][method]
+        if row["status"] == "complete":
+            plans[method] = research_strategy_from_record(row["strategy"], spec)
+            if plans[method].method != method:
+                raise ValueError("Recorded strategy belongs to another method")
+        elif row["status"] not in {"failed", "abstained"} or row["strategy"] is not None:
+            raise ValueError("Every method must finish planning before private reference load")
+    report = {"version": VERSION, "planning_suite_seal_hash": claimed,
+        "scope": "generated_target_only_independent_geometry_and_cell_accounting",
+        "private_reference_loaded": False, "patient_generalization": None,
+        "pre_reference_nominal_replay_transition_calls": sum(len(plan.action_ids) for plan in plans.values()),
+        "pre_reference_validation_seconds": time.perf_counter() - started,
+        "clinical_validation": None, "methods": {method: {"planning_status": payload["methods"][method]["status"],
+            "evaluation_status": "not_evaluated", "outcomes": None} for method in METHODS}}
+    if plans:
+        if not callable(load_reference):
+            raise ValueError("Evaluator-owned zero-argument reference loader required")
+        reference = np.asarray(load_reference())
+        if (reference.shape != spec.target.mask.shape or reference.dtype.kind not in "biuf"
+                or not np.isfinite(reference).all() or not np.isin(reference, (0, 1)).all()):
+            raise ValueError("Generated evaluator reference requires a finite binary source grid")
+        reference = immutable_array(reference, bool)
+        report.update(private_reference_loaded=True, reference_hash=array_digest(reference))
+        for method, plan in plans.items():
+            row = report["methods"][method]
+            try:
+                task = NativeSpatialTask(_estimate_case(spec, reference), max_steps=spec.horizon, reward=spec.reward)
+                for action in plan.action_ids:
+                    task.step(action)
+                if _physical_hash(task.metrics()["history"]) != plan.physical_history_hash:
+                    raise ValueError("Evaluator target changed the committed physical strategy")
+                audited = evaluate_native_spatial_episode(task)
+                row.update(evaluation_status="accepted" if audited["accepted"] else "rejected",
+                    independent_evaluation=audited, outcomes=audited["outcomes"],
+                    physical_history_hash=plan.physical_history_hash,
+                    replay_transition_calls=len(plan.action_ids))
+            except Exception as error:
+                row.update(evaluation_status="failed", error=type(error).__name__ + ": " + str(error))
+    report["evaluation_total_seconds"] = time.perf_counter() - started
+    _write(Path(output), report)
+    return thaw_json(freeze_json(report))
