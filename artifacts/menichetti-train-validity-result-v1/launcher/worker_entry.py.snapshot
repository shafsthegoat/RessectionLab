"""Pin the loaded code/runtime before and after the exact reviewed QC worker."""
from pathlib import Path
import argparse, hashlib, importlib.util, json, platform, sys, sysconfig

ROOT = Path(__file__).resolve().parents[2]
WORKER = 'build/menichetti-train-validity-preparation-v1/train_validity.py'
WORKER_SHA = '2eddae70e5e38d79bf1325dcb9fce574b49ef30098278cd055090c0067e41d6c'
RUNTIME = 'build/menichetti-train-validity-launch-preparation-v1/runtime-closure.json'

def need(ok, reason):
    if not ok:
        raise RuntimeError(reason)

def file_binding(path):
    path = Path(path).resolve()
    size = path.stat().st_size
    need(path.is_file() and size <= 64*1024**2, 'runtime_file_type_or_size')
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        while block := stream.read(1024**2):
            digest.update(block)
    return {'path': str(path), 'bytes': size, 'sha256': digest.hexdigest()}

def load_worker():
    need(file_binding(ROOT/WORKER)['sha256'] == WORKER_SHA, 'reviewed_worker_changed')
    spec = importlib.util.spec_from_file_location('menichetti_train_validity_worker', ROOT/WORKER)
    worker = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = worker
    spec.loader.exec_module(worker)
    need(Path(worker.__file__).resolve() == ROOT/WORKER, 'worker_origin')
    need(Path(worker.base.__file__).resolve() == ROOT/worker.BASE, 'base_parser_origin')
    # Warm only predeclared generated scalar QC; never touch the response file.
    worker.trial_qc(worker.np.array([0., -1., 2., worker.np.nan, worker.np.inf, -worker.np.inf]))
    worker.trial_qc(worker.np.zeros(3))
    return worker

def runtime_record(worker):
    """Complete loaded Python module file map; explicit local native runtimes."""
    modules, files, intrinsic = {}, {}, []
    for name, module in sorted(tuple(sys.modules.items())):
        if name == '__main__' or name == __name__:
            continue
        filename = getattr(module, '__file__', None)
        if filename is None:
            intrinsic.append(name)
            continue
        path = Path(filename).resolve()
        # Modules must originate in the private interpreter, venv or exact worker.
        need(path.is_relative_to(Path(sys.base_prefix).resolve())
             or path.is_relative_to(ROOT/'.venv') or path == ROOT/WORKER,
             'loaded_module_outside_frozen_runtime:' + name)
        modules[name] = str(path)
        if str(path) not in files:
            files[str(path)] = file_binding(path)
    source_paths = [Path(__file__).resolve(), ROOT/WORKER, ROOT/worker.BASE]
    sources = {str(path):file_binding(path) for path in source_paths}
    local_native = {}
    for package in ('numpy', 'scipy'):
        directory = ROOT/'.venv/lib/python3.12/site-packages'/package/'.dylibs'
        if directory.is_dir():
            for path in sorted(directory.iterdir()):
                need(path.is_file() and path.suffix == '.dylib', 'unexpected_bundled_runtime_entry')
                local_native[str(path.resolve())] = file_binding(path)
    python_library = Path(sys.base_prefix)/'lib'/sysconfig.get_config_var('LDLIBRARY')
    need(python_library.is_file(), 'python_shared_library_unavailable')
    local_native[str(python_library.resolve())] = file_binding(python_library)
    need(len(modules) <= 1000 and len(files) <= 1000, 'runtime_closure_budget')
    return {'schema':'menichetti-loaded-runtime-closure-v1',
            'python_executable':file_binding(Path(sys.executable)), 'python_version':sys.version,
            'python_base_prefix':str(Path(sys.base_prefix).resolve()),
            'platform':{'system':platform.system(),'release':platform.release(),'machine':platform.machine()},
            'numpy_version':worker.np.__version__,'scipy_version':worker.base.scipy.__version__,
            'loaded_module_origins':modules,'loaded_module_files':files,
            'intrinsic_module_names':intrinsic,'executing_sources':sources,'local_native_runtime_files':local_native,
            'system_library_scope':'OS-provided libraries/shared cache are identified by platform release, not copied or byte-pinned.',
            'scientific_response_access':False}

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument('--prepare-runtime',action='store_true')
    parser.add_argument('--runtime-sha256')
    parser.add_argument('--protocol')
    parser.add_argument('--protocol-sha256')
    parser.add_argument('--check-only',action='store_true')
    args=parser.parse_args()
    worker=load_worker()
    observed=runtime_record(worker)
    if args.prepare_runtime:
        need(args.protocol is None and args.protocol_sha256 is None and args.runtime_sha256 is None,
             'runtime_preparation_cannot_execute_worker')
        raw=(json.dumps(observed,sort_keys=True,indent=2)+'\n').encode()
        need(len(raw)<=1024**2,'runtime_snapshot_size')
        with (ROOT/RUNTIME).open('xb') as stream:stream.write(raw)
        print(json.dumps({'status':'runtime_prepared_without_MAT_access','modules':len(observed['loaded_module_origins']),
                          'runtime_sha256':hashlib.sha256(raw).hexdigest(),'original_MAT_opens':0}))
        return
    need(args.runtime_sha256 and args.protocol and args.protocol_sha256, 'execution_bindings_required')
    path=ROOT/RUNTIME
    need(not path.is_symlink() and path.stat().st_size<=1024**2,'runtime_snapshot_type_or_size')
    raw=path.read_bytes()
    need(hashlib.sha256(raw).hexdigest()==args.runtime_sha256,'runtime_snapshot_changed')
    expected=json.loads(raw)
    need(observed==expected,'loaded_runtime_closure_changed_before_worker')
    sys.argv=[str(ROOT/WORKER),'--protocol',args.protocol,'--protocol-sha256',args.protocol_sha256]
    if args.check_only:sys.argv.append('--check-only')
    worker.main()
    need(runtime_record(worker)==expected,'loaded_runtime_closure_changed_after_worker')

if __name__=='__main__':
    main()
